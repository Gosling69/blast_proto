{
  "compilerOptions": {
    "module": "commonjs",
    "lib": [ "es2015", "es2017", "dom" ],
    "target": "es5",
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "temp/vscode-dist",
    "forceConsistentCasingInFileNames": true
  },
   "include": [
    "assets/**/*.ts",
    "creator.d.ts"
  ],
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "settings"
  ]
}